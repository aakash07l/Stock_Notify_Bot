# ==========================================
# Telegram Bot Alert Configuration
# ==========================================
# Obtain BOT_TOKEN from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=8971931761:AAGWNKotjJwaX0a641b...

# Obtain numeric CHAT_ID from @userinfobot on Telegram
TELEGRAM_CHAT_ID=5701727023

# ==========================================
# Monitoring Loop & Notification Options
# ==========================================
# Interval between monitoring sweeps in seconds (240s = 4 minutes)
CHECK_INTERVAL_SECONDS=240

# Delay between hitting each site (seconds)
SITE_CHECK_DELAY_SECONDS=4

# Set to True so you receive stock alerts immediately on startup for items currently in stock
NOTIFY_ON_INITIAL_RUN=True

# Sends an immediate confirmation message when the bot launches on Replit
SEND_STARTUP_MESSAGE=True

# Sends a full stock report of all 5 platforms after the first sweep completes
SEND_INITIAL_SUMMARY=True

# Periodic summary update every 24 hours (360 cycles * 4m = ~24 hours)
PERIODIC_SUMMARY_CYCLES=360

# Periodic heartbeat notification every 24 hours (360 cycles * 4m = ~24 hours). Set to 0 to disable
HEARTBEAT_CYCLE_INTERVAL=360


# Port for Keep-Alive Web Server & Live Dashboard (Replit default: 8080)
PORT=8080
