# ==========================================
# Telegram Bot Alert Configuration
# ==========================================
# Get your BOT_TOKEN from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxyz

# Get your numeric CHAT_ID from @userinfobot or @raw_data_bot on Telegram
TELEGRAM_CHAT_ID=987654321

# ==========================================
# Monitoring Loop Options
# ==========================================
# Interval between monitoring loops in seconds (e.g., 240 = 4 minutes)
CHECK_INTERVAL_SECONDS=240

# Delay between hitting each site (to avoid rate limits and CPU spikes)
SITE_CHECK_DELAY_SECONDS=4

# Set to True if you want a notification on the very first run if an item is already In Stock
# Set to False (recommended) to only alert when transitioning from Out of Stock -> In Stock
NOTIFY_ON_INITIAL_RUN=False

# Port for Keep-Alive Web Server (Replit assigns 8080 or PORT automatically)
PORT=8080
